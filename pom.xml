<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.supermarketmanager</groupId>
    <artifactId>supermarket-manager-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Supermarket Manager</name>
    <description>Pantry targets, item rules, price comparison and supermarket baskets - chainable modules with REST, UI and MCP.</description>

    <modules>
        <module>modules/basket-core</module>
        <module>modules/pantry</module>
        <module>modules/item-rules</module>
        <module>modules/price-comparison</module>
        <module>modules/supermarkets</module>
        <module>modules/pipeline</module>
        <module>modules/mcp-server</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <node.version>v24.14.0</node.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarketmanager</groupId>
                <artifactId>basket-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarketmanager</groupId>
                <artifactId>pantry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarketmanager</groupId>
                <artifactId>item-rules</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarketmanager</groupId>
                <artifactId>price-comparison</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarketmanager</groupId>
                <artifactId>supermarkets</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarketmanager</groupId>
                <artifactId>pipeline</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarketmanager</groupId>
                <artifactId>mcp-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarketmanager</groupId>
                <artifactId>basket-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
